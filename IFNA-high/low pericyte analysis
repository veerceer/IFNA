saveRDS(rosmap_ifna_sub, file.path(out_dir, "ROSMAP_LE35_user_code_low_high_subset_for_MAST.rds"))

de_ifna_mast <- FindMarkers(
  object = rosmap_ifna_sub,
  ident.1 = "IFNA_high",
  ident.2 = "IFNA_low",
  test.use = "MAST",
  assay = "RNA",
  latent.vars = latent_use,
  logfc.threshold = 0,
  min.pct = 0.05
)

de_ifna_mast$gene <- rownames(de_ifna_mast)

de_ifna_mast <- de_ifna_mast %>%
  arrange(p_val_adj)

write.csv(
