score <- rosmap_pericyte@meta.data[[score_col]]

q25 <- quantile(score, 0.25, na.rm = TRUE)
q75 <- quantile(score, 0.75, na.rm = TRUE)

rosmap_pericyte$IFNA_state <- NA
rosmap_pericyte$IFNA_state[score <= q25] <- "IFNA_low"
rosmap_pericyte$IFNA_state[score >= q75] <- "IFNA_high"

state_table <- table(rosmap_pericyte$IFNA_state, useNA = "ifany")
print(state_table)

write.csv(
  data.frame(
    cell = colnames(rosmap_pericyte),
    IFNA_ROSMAP_LE = score,
    IFNA_state = rosmap_pericyte$IFNA_state
  ),
  file.path(out_dir, "ROSMAP_LE35_user_code_scores_and_state.csv"),
  row.names = FALSE
)
write.csv(
  as.data.frame(state_table),
  file.path(out_dir, "ROSMAP_LE35_user_code_state_counts.csv"),
  row.names = FALSE
)

rosmap_ifna_sub <- subset(
  rosmap_pericyte,
  subset = IFNA_state %in% c("IFNA_low", "IFNA_high")
)

rosmap_ifna_sub$IFNA_state <- factor(
  rosmap_ifna_sub$IFNA_state,
  levels = c("IFNA_low", "IFNA_high")
)

Idents(rosmap_ifna_sub) <- "IFNA_state"

latent_use <- c("nFeature_RNA", "percent.mt")
latent_use <- latent_use[latent_use %in% colnames(rosmap_ifna_sub@meta.data)]
print(latent_use)

complete_cells <- complete.cases(rosmap_ifna_sub@meta.data[, latent_use, drop = FALSE])
