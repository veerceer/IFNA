write.table(
  data.frame(gene = ifna_leading_genes, in_object = ifna_leading_genes %in% rownames(ROSMAP_pericyte)),
  file.path(out_dir, "ROSMAP_LE35_user_code_genes_used.tsv"),
  sep = "\t",
  quote = FALSE,
  row.names = FALSE
)

before_cols <- colnames(ROSMAP_pericyte@meta.data)
rosmap_pericyte <- AddModuleScore_UCell(
  ROSMAP_pericyte,
  features = list(IFNA_ROSMAP_LE = genes_use),
  name = NULL
)

score_candidates <- colnames(rosmap_pericyte@meta.data)[
  grepl("IFNA_ROSMAP_LE", colnames(rosmap_pericyte@meta.data))
]
write.table(
  data.frame(score_candidate = score_candidates),
  file.path(out_dir, "ROSMAP_LE35_user_code_score_columns.tsv"),
  sep = "\t",
  quote = FALSE,
  row.names = FALSE
)

score_col <- "IFNA_ROSMAP_LE"
if (!score_col %in% colnames(rosmap_pericyte@meta.data)) {
  stop("Expected score column IFNA_ROSMAP_LE was not found. Candidates: ", paste(score_candidates, collapse = ", "))
