library(dplyr)
library(ggplot2)
library(ggrepel)
fc_cut <- 0.25
padj_cut <- 0.05

volcano_df2 <- volcano_df %>%
  dplyr::mutate(
    significance = dplyr::case_when(
      p_val_adj < padj_cut & avg_log2FC >  fc_cut ~ "Upregulated",
      p_val_adj < padj_cut & avg_log2FC < -fc_cut ~ "Downregulated",
      TRUE ~ "Not significant"
    ),
    significance = factor(
      significance,
      levels = c(
        "Upregulated",
        "Downregulated",
        "Not significant"
      )
    )
  )

table(volcano_df2$significance)

label_df <- dplyr::bind_rows(
  volcano_df2 %>%
    dplyr::filter(significance == "Upregulated") %>%
    dplyr::arrange(p_val_adj, dplyr::desc(abs(avg_log2FC))) %>%
    dplyr::slice_head(n = 6),
  
  volcano_df2 %>%
    dplyr::filter(significance == "Downregulated") %>%
    dplyr::arrange(p_val_adj, dplyr::desc(abs(avg_log2FC))) %>%
    dplyr::slice_head(n = 4)
)
scale_color_manual(
  values = c(
    "Upregulated" = "#E45756",
    "Downregulated" = "#4C78A8",
    "Not significant" = "grey78"
  )
)

p_volcano <- ggplot(
  volcano_df2,
  aes(x = avg_log2FC, y = neg_log10_padj)
) +
  geom_point(
    aes(color = significance),
    size = 1.6,
    alpha = 0.78
  ) +
  geom_vline(
    xintercept = c(-fc_cut, fc_cut),
    linetype = "dashed",
    linewidth = 0.5,
    color = "grey45"
  ) +
  geom_hline(
    yintercept = -log10(padj_cut),
    linetype = "dashed",
    linewidth = 0.5,
    color = "grey45"
  ) +
  ggrepel::geom_text_repel(
    data = label_df,
    aes(label = gene),
    size = 3.2,
    box.padding = 0.35,
    point.padding = 0.2,
    segment.color = "grey55",
    segment.size = 0.35,
    min.segment.length = 0,
    max.overlaps = Inf,
    show.legend = FALSE
  ) +
  scale_color_manual(
    values = c(
      "Upregulated" = "#E45756",
      "Downregulated" = "#4C78A8",
      "Not significant" = "grey78"
    )
  ) +
  coord_cartesian(xlim = c(-1.5, 4.5)) +
  labs(
    x = expression(log[2]~fold~change),
    y = expression(-log[10]~adjusted~italic(P)),
    color = NULL
  ) +
  theme_classic(base_size = 12) +
  theme(
    axis.title = element_text(face = "bold", size = 11),
    axis.text = element_text(color = "black", size = 10),
    axis.line = element_line(color = "black", linewidth = 0.5),
