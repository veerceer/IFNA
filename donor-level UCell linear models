message("Reading Supplymentary1 leading genes...")
gsea <- read.delim(gsea_path, check.names = FALSE)
target_pathways <- c(
  INTERFERON_ALPHA_RESPONSE = "HALLMARK_INTERFERON_ALPHA_RESPONSE",
  MYC_TARGETS_V2 = "HALLMARK_MYC_TARGETS_V2",
  MITOTIC_SPINDLE = "HALLMARK_MITOTIC_SPINDLE",
  G2M_CHECKPOINT = "HALLMARK_G2M_CHECKPOINT"
)
gsea_sub <- gsea[
  gsea$dataset == "ROSMAP" &
    gsea$method == "nebula" &
    gsea$model_label == "+age" &
    gsea$pathway %in% unname(target_pathways),
]
if (nrow(gsea_sub) != length(target_pathways)) {
  stop("Expected ", length(target_pathways), " selected GSEA rows; found ", nrow(gsea_sub))
}

gene_sets <- lapply(target_pathways, function(pathway) {
  split_leading(gsea_sub$leadingEdge[gsea_sub$pathway == pathway][1])
})
names(gene_sets) <- names(target_pathways)
features <- lapply(gene_sets, function(g) intersect(g, rownames(mat)))

gene_counts <- data.frame(
  module = names(gene_sets),
  pathway = unname(target_pathways),
  n_leading = lengths(gene_sets),
  n_present = vapply(features, length, integer(1)),
  genes_used = vapply(features, paste, collapse = ";", FUN.VALUE = character(1)),
  stringsAsFactors = FALSE
)
write.csv(gene_counts, file.path(out_dir, "Supplymentary1_ROSMAP_nebula_age_leading_gene_counts.csv"), row.names = FALSE)

message("Computing UCell scores...")
uc <- UCell::ScoreSignatures_UCell(
  matrix = mat,
  features = features,
  maxRank = 1500,
  name = "",
  chunk.size = 100,
  ncores = 1
)
uc <- as.data.frame(uc)

cell_scores <- data.frame(
  cell = colnames(mat),
  donor_id = md$donor_id,
  subject = if ("subject" %in% colnames(md)) md$subject else md$donor_id,
  disease = md$disease_std,
  sex = md$sex_std,
  age = md$age_analysis,
  PMI = md$pmi_hours_analysis,
  stringsAsFactors = FALSE
)
for (nm in names(features)) cell_scores[[nm]] <- uc[[nm]]
write.csv(cell_scores, file.path(out_dir, "Supplymentary1_leading_UCell_cell_scores.csv"), row.names = FALSE)

message("Aggregating donor means...")
donors <- unique(cell_scores$donor_id)
donor_scores <- do.call(rbind, lapply(donors, function(id) {
  d <- cell_scores[cell_scores$donor_id == id, , drop = FALSE]
  row <- data.frame(
    donor_id = id,
    subject = first_non_na(d$subject),
    disease = first_non_na(d$disease),
    sex = first_non_na(d$sex),
    age = first_non_na(d$age),
    PMI = first_non_na(d$PMI),
    n_cells = nrow(d),
    stringsAsFactors = FALSE
  )
  for (nm in names(features)) row[[nm]] <- mean_no_na(d[[nm]])
  row
}))
donor_scores <- donor_scores[
