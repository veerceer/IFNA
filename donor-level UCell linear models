get_layer_matrix <- function(seu, assay_name = NULL, layer_name = "data.1") {
  if (is.null(assay_name)) assay_name <- attr(seu, "active.assay")
  assay <- attr(seu, "assays")[[assay_name]]
  mat <- attr(assay, "layers")[[layer_name]]
  features <- attr(assay, "features")
  cells <- attr(assay, "cells")
  attr(features, "class") <- NULL
  attr(cells, "class") <- NULL
  genes <- dimnames(features)[[1]][features[, layer_name]]
  cell_names <- dimnames(cells)[[1]][cells[, layer_name]]
  rownames(mat) <- genes
  colnames(mat) <- cell_names
  mat
}

split_leading <- function(x) {
  x <- unlist(strsplit(x, "[,;]"))
  x <- trimws(x)
  unique(x[nzchar(x)])
}

first_non_na <- function(x) {
  x <- x[!is.na(x)]
  if (length(x) == 0) return(NA)
  x[1]
}

mean_no_na <- function(x) {
  if (all(is.na(x))) return(NA_real_)
  mean(x, na.rm = TRUE)
}

fit_one <- function(dat, score_col, comparison, predictor, covars, group_var, group_a, group_b) {
  use_cols <- unique(c(score_col, predictor, covars, group_var))
  d <- dat[, use_cols, drop = FALSE]
  names(d)[names(d) == score_col] <- "score"
  d <- d[complete.cases(d), , drop = FALSE]
  d[[predictor]] <- droplevels(factor(d[[predictor]]))
  if (nrow(d) < 6 || length(unique(d[[predictor]])) < 2) {
    return(data.frame(
      comparison = comparison, module = score_col, n = nrow(d),
      n_group_a = sum(d[[group_var]] == group_a, na.rm = TRUE),
      n_group_b = sum(d[[group_var]] == group_b, na.rm = TRUE),
      group_a = group_a, group_b = group_b,
      mean_group_a = mean_no_na(d$score[d[[group_var]] == group_a]),
      mean_group_b = mean_no_na(d$score[d[[group_var]] == group_b]),
      beta = NA_real_, p = NA_real_, direction = NA_character_,
      model = NA_character_, stringsAsFactors = FALSE
    ))
  }
  form <- as.formula(paste("score ~", paste(c(predictor, covars), collapse = " + ")))
  fit <- lm(form, data = d)
  co <- summary(fit)$coefficients
  term <- grep(paste0("^", predictor), rownames(co), value = TRUE)[1]
  beta <- unname(co[term, "Estimate"])
  p <- unname(co[term, "Pr(>|t|)"])
  mean_a <- mean_no_na(d$score[d[[group_var]] == group_a])
  mean_b <- mean_no_na(d$score[d[[group_var]] == group_b])
  data.frame(
    comparison = comparison,
    module = score_col,
    n = nrow(d),
    n_group_a = sum(d[[group_var]] == group_a, na.rm = TRUE),
    n_group_b = sum(d[[group_var]] == group_b, na.rm = TRUE),
    group_a = group_a,
    group_b = group_b,
    mean_group_a = mean_a,
    mean_group_b = mean_b,
    beta = beta,
    p = p,
    direction = ifelse(beta > 0, paste0(group_b, " higher"), paste0(group_b, " lower")),
    model = paste(deparse(form), collapse = ""),
    stringsAsFactors = FALSE
  )
}

message("Reading object...")
seu <- readRDS(rds_path)
